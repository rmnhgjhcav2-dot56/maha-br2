# Copy this file to .env.local and fill in the values from
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and config.
# These are PUBLIC identifiers (safe to ship in the frontend bundle) — they identify
# your Firebase project, they are not secret credentials. Access control is enforced
# by Firestore/Storage Security Rules and Firebase Auth, not by hiding these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
